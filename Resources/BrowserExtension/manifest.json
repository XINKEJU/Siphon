{
  "manifest_version": 3,
  "name": "Siphon Connector",
  "version": "0.3.0",
  "description": "Send browser downloads to the native Siphon macOS app.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest",
    "scripting",
    "tabs",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": ["http://127.0.0.1/*", "*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Siphon",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
