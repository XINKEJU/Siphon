{
  "manifest_version": 3,
  "name": "Siphon Connector",
  "version": "0.1.0",
  "description": "Send browser downloads to the native Siphon macOS app.",
  "permissions": ["downloads", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:17801/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Siphon",
    "default_popup": "popup.html"
  },
  "icons": {}
}
